# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud -> App settings -> Secrets when deploying.
# This file is gitignored — never commit real secrets.toml.

OPENAI_API_KEY = "sk-your-key-here"
DATABASE_URL = "postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"
EMBEDDING_MODEL = "text-embedding-3-small"
CHAT_MODEL = "gpt-4o-mini"
SHORTLIST_SIZE = "10"
